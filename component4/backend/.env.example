FLASK_APP=run.py
FLASK_ENV=development
DATABASE_URL=mysql+pymysql://gloveiq_user:password@localhost:3306/gloveiq
FRONTEND_ORIGIN=http://localhost:5173
SECRET_KEY=replace-me
MAX_UPLOAD_BYTES=5242880
QUALITY_REJECTION_THRESHOLD=5
REJECT_GRADE_THRESHOLD=5
RISK_LOW_PROBABILITY=0.33
RISK_HIGH_PROBABILITY=0.66
PREDICTIVE_RANDOM_STATE=42
PREDICTIVE_N_ESTIMATORS=300
PREDICTIVE_MIN_RECORDS=8
SORTING_TELEMETRY_STALE_SECONDS=1
COMPONENT3_DRIVER_ENABLED=true
COMPONENT3_SERIAL_PORT=COM7
COMPONENT3_BAUD_RATE=115200
SORTING_EXPECTED_ORIENTATION=LeftHand
SORTING_WARNING_THRESHOLD=3
ORIENTATION_CAMERA_INDEX=0
CAMERA_AUTO_EXPOSURE=false
CAMERA_EXPOSURE=-2
CAMERA_GAIN=0
ORIENTATION_MIN_CONFIDENCE=0.60
ORIENTATION_SMOOTHING_WINDOW=7
ORIENTATION_CLEAR_AFTER_FRAMES=4
DEFECT_MIN_CONFIDENCE=0.30
DEFECT_IMAGE_SIZE=640
DEFECT_INFERENCE_INTERVAL=2
# Optional absolute path. Defaults to the included TorchScript model.
# ORIENTATION_MODEL_PATH=
# Optional absolute path. Defaults to ml/defect_detection/weight/best.pt.
# DEFECT_MODEL_PATH=
# Optional absolute path. Defaults to component4/models.
# PREDICTIVE_MODEL_DIR=
